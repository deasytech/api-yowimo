APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yowimo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Clerk is the identity provider. Laravel never issues its own auth tokens.
# CLERK_ISSUER is your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL is typically {CLERK_ISSUER}/.well-known/jwks.json
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_JWKS_CACHE_TTL=3600
# Signing secret for the Clerk (Svix) webhook endpoint, from the Clerk dashboard's webhook settings.
CLERK_WEBHOOK_SECRET=
# Backend API secret key (sk_...), from the Clerk dashboard's API Keys page. Only used
# for server-to-server Backend API calls (e.g. the clerk:sync-users command) — never
# expose this to a client.
CLERK_SECRET_KEY=

# Password for the seeded Super Admin user. Falls back to a local-development
# default when unset — always set this explicitly in staging/production.
SUPER_ADMIN_PASSWORD=

# Comma-separated list of browser origins allowed to call the API. Left empty by default
# since the primary client is the mobile app, which isn't subject to CORS.
CORS_ALLOWED_ORIGINS=

VITE_APP_NAME="${APP_NAME}"

# Reverb (WebSocket broadcasting). REVERB_APP_ID/KEY/SECRET are generated
# per environment via `php artisan reverb:install` / the Reverb dashboard —
# never share the secret with a client.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Firebase Cloud Messaging (push notifications). Path to the Firebase service
# account JSON key file, RELATIVE to storage/app/private/ (resolved via
# storage_path() in AppServiceProvider so the same value works on every
# machine/environment regardless of the repo's absolute path). Place the
# downloaded key at storage/app/private/firebase/credentials.json (already
# gitignored) and set this to "firebase/credentials.json".
# See https://firebase.google.com/docs/admin/setup#initialize_the_sdk.
# Never commit the actual credentials file.
FIREBASE_CREDENTIALS=

# Error tracking (Sentry). No project is configured yet in any environment —
# error reporting is wired but inert until this is set.
SENTRY_LARAVEL_DSN=
