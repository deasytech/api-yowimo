              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/token-bundles?per_page=20",
              "host": ["{{base_url}}"],
              "path": ["token-bundles"],
              "query": [{ "key": "per_page", "value": "20" }, { "key": "cursor", "value": "", "disabled": true }]
            }
          }
        },
        {
          "name": "Purchase token bundle",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{base_url}}/token-bundles/{{token_bundle_id}}/purchase", "host": ["{{base_url}}"], "path": ["token-bundles", "{{token_bundle_id}}", "purchase"] },
            "description": "Credits your wallet via the manual/test PaymentProvider. Idempotency-Key header required. Rate-limited: 10/min (`purchases`)."
          }
        }
      ]
    },
