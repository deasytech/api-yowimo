    {
      "name": "Parties",
      "item": [
        {
          "name": "List parties",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/parties?per_page=20",
              "host": ["{{base_url}}"],
              "path": ["parties"],
              "query": [
                { "key": "per_page", "value": "20" },
                { "key": "mode", "value": "online", "disabled": true },
                { "key": "game_type_id", "value": "{{game_type_id}}", "disabled": true },
                { "key": "search", "value": "", "disabled": true },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create party",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) { pm.collectionVariables.set('party_id', body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Friday Night Party\",\n  \"description\": \"Truth or dare, online\",\n  \"game_type_id\": {{game_type_id}},\n  \"pack_id\": {{pack_id}},\n  \"mode\": \"online\",\n  \"visibility\": \"public\",\n  \"max_players\": 10,\n  \"tags\": [\"fun\", \"casual\"]\n}"
            },
            "url": { "raw": "{{base_url}}/parties", "host": ["{{base_url}}"], "path": ["parties"] },
            "description": "`mode` (online|hybrid|in_person) and `visibility` (public|private) are required. `location` is required when mode is hybrid or in_person. See StorePartyRequest for full rules."
          }
        },
        {
          "name": "Show party",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/parties/{{party_id}}", "host": ["{{base_url}}"], "path": ["parties", "{{party_id}}"] }
          }
        },
        {
          "name": "Like party",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/parties/{{party_id}}/like", "host": ["{{base_url}}"], "path": ["parties", "{{party_id}}", "like"] },
            "description": "Rate-limited: 30/min (`party-actions`)."
          }
        },
        {
          "name": "Unlike party",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/parties/{{party_id}}/like", "host": ["{{base_url}}"], "path": ["parties", "{{party_id}}", "like"] }
          }
        },
        {
          "name": "Join party",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/parties/{{party_id}}/join", "host": ["{{base_url}}"], "path": ["parties", "{{party_id}}", "join"] }
          }
        },
        {
          "name": "Leave party",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/parties/{{party_id}}/leave", "host": ["{{base_url}}"], "path": ["parties", "{{party_id}}", "leave"] }
          }
        },
        {
          "name": "Start party (host only)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/parties/{{party_id}}/start", "host": ["{{base_url}}"], "path": ["parties", "{{party_id}}", "start"] },
            "description": "Marks the party live. This is party-lifecycle start, distinct from the game session start below."
          }
        },
        {
          "name": "End party (host only)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/parties/{{party_id}}/end", "host": ["{{base_url}}"], "path": ["parties", "{{party_id}}", "end"] }
          }
        }
      ]
    },
    {
      "name": "Game Sessions",
      "item": [
        {
          "name": "Start game (host only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) { pm.collectionVariables.set('game_session_id', body.data.id); }",
                  "if (body.data && body.data.current_turn && body.data.current_turn.id) { pm.collectionVariables.set('turn_id', body.data.current_turn.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rounds\": 5\n}"
            },
            "url": { "raw": "{{base_url}}/parties/{{party_id}}/game/start", "host": ["{{base_url}}"], "path": ["parties", "{{party_id}}", "game", "start"] },
            "description": "`rounds` must be one of GameSessionService::ALLOWED_ROUNDS_COUNTS (optional, defaults server-side if omitted). Party must be Live with the host present. Rate-limited: 30/min (`party-actions`)."
          }
        },
        {
          "name": "Get game state",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/game/{{game_session_id}}", "host": ["{{base_url}}"], "path": ["game", "{{game_session_id}}"] },
            "description": "Full current state for (re)loading a game: the start/next-turn fields plus host_id, pack_id, turn_order and current_turn_index. Host or active party member only (403 otherwise)."
          }
        },
        {
          "name": "Advance to next turn (host only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.current_turn && body.data.current_turn.id) { pm.collectionVariables.set('turn_id', body.data.current_turn.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/game/{{game_session_id}}/next-turn", "host": ["{{base_url}}"], "path": ["game", "{{game_session_id}}", "next-turn"] },
            "description": "Advances the turn/round; auto-completes the session on the last turn of the last round (fires GameCompleted/RoundCompleted). Rate-limited: 30/min (`party-actions`)."
          }
        },
        {
          "name": "Vote on a turn",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"winner\"\n}"
            },
            "url": { "raw": "{{base_url}}/game/{{game_session_id}}/turns/{{turn_id}}/vote", "host": ["{{base_url}}"], "path": ["game", "{{game_session_id}}", "turns", "{{turn_id}}", "vote"] },
            "description": "`category` must be one of: winner, funny, creativity. Voting is only allowed once the turn has completed (422 otherwise). Rate-limited: 30/min (`party-actions`)."
          }
        }
      ]
    },
    {
      "name": "Push Tokens",
      "item": [
        {
          "name": "Register push token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"sample-device-push-token\",\n  \"platform\": \"ios\"\n}"
            },
            "url": { "raw": "{{base_url}}/push-tokens", "host": ["{{base_url}}"], "path": ["push-tokens"] },
            "description": "`platform` is `ios` or `android`. One token per user; registering again replaces it. Rate-limited: 10/min (`push-tokens`)."
          }
        },
        {
          "name": "Remove push token",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/push-tokens", "host": ["{{base_url}}"], "path": ["push-tokens"] }
          }
        }
      ]
    },
