            "description": "Soft-deletes to a `removed` status rather than a hard delete."
          }
        },
        {
          "name": "List blocked users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/blocks", "host": ["{{base_url}}"], "path": ["blocks"] },
            "description": "Users you have blocked, newest first. Not paginated."
          }
        },
        {
          "name": "Block a user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}}\n}"
            },
            "url": { "raw": "{{base_url}}/blocks", "host": ["{{base_url}}"], "path": ["blocks"] },
            "description": "Closes any friendship between you (accepted -> removed, your pending -> cancelled, theirs -> rejected); after that neither side can send a friend request (403) and each sees the other's profile as 404. 201 when new, 200 if already blocked. Rate-limited: 20/min (`friend-requests`)."
          }
        },
        {
          "name": "Unblock a user",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/blocks/{{user_id}}", "host": ["{{base_url}}"], "path": ["blocks", "{{user_id}}"] },
            "description": "Removes only your own block; closed friendships are not restored. Rate-limited: 20/min (`friend-requests`)."
          }
        }
      ]
    }
  ]
}
