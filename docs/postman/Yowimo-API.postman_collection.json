{
  "info": {
    "name": "Yowimo API",
    "description": "Yowimo backend API (routes/api.php).\n\nAuth: every endpoint except `GET /health` and `POST /webhooks/clerk` requires a Bearer JWT verified against Clerk's JWKS (the `clerk` guard, see `AppServiceProvider::boot()` / `config/auth.php`). Set the `bearer_token` collection variable to a real Clerk session token (e.g. copy it from your frontend's signed-in session, or Clerk's dashboard for a test user) — there is no local/offline way to mint one outside the test suite's `FakesClerk` trait.\n\nMany requests carry a small test script that captures ids (party_id, game_session_id, turn_id, pack_id, token_bundle_id, friendship_id, notification_id, game_type_id) from the response into collection variables, so running requests top-to-bottom within a folder chains naturally (e.g. create a party -> start the game -> advance turns -> vote).\n\nRate limits (see `AppServiceProvider`): `purchases` 10/min, `friend-requests` 20/min, `party-actions` 30/min, `push-tokens` 10/min, all stacked on the global `api` limiter (60/min) — expect 429s if you replay a request rapidly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{bearer_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://api-yowimo.test/api/v1", "type": "string" },
    { "key": "bearer_token", "value": "", "type": "string" },
    { "key": "party_id", "value": "", "type": "string" },
    { "key": "pack_id", "value": "", "type": "string" },
    { "key": "token_bundle_id", "value": "", "type": "string" },
    { "key": "game_type_id", "value": "", "type": "string" },
    { "key": "game_session_id", "value": "", "type": "string" },
    { "key": "turn_id", "value": "", "type": "string" },
    { "key": "friendship_id", "value": "", "type": "string" },
    { "key": "notification_id", "value": "", "type": "string" },
    { "key": "receiver_id", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health & Webhooks",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "auth": { "type": "noauth" },
            "description": "Public. Checks DB/Redis/Queue/Broadcast(Reverb)."
          }
        },
        {
          "name": "Clerk webhook (svix)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "svix-id", "value": "msg_replace_me" },
              { "key": "svix-timestamp", "value": "1700000000" },
              { "key": "svix-signature", "value": "v1,replace_me" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"user.created\",\n  \"data\": {}\n}"
            },
            "url": { "raw": "{{base_url}}/webhooks/clerk", "host": ["{{base_url}}"], "path": ["webhooks", "clerk"] },
            "auth": { "type": "noauth" },
            "description": "Signature-verified via svix (App\\Http\\Controllers\\Api\\V1\\ClerkWebhookController). Real requests come from Clerk itself; the svix-* headers above are placeholders and will 401 unless replaced with a genuinely signed payload."
          }
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"party_host_01\",\n  \"display_name\": \"Party Host\",\n  \"bio\": \"Here to host games.\",\n  \"country_code\": \"US\",\n  \"interests\": [\"party games\", \"trivia\"]\n}"
            },
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] },
            "description": "All fields are optional (`sometimes`). See UpdateProfileRequest for full validation rules (username regex, avatar_url, date_of_birth, privacy_settings, etc.)."
          }
        },
        {
          "name": "Get a public profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["users", "{{user_id}}"] },
            "description": "Another user's public profile: id, username, display_name, avatar_url, xp, badges, and friendship {id, status}. status is one of none, friends, request_sent, request_received, self. 404 for a deactivated/deleted user or when either side has blocked the other."
          }
        },
        {
          "name": "Delete my account",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] },
            "description": "Deletes the Clerk user, then soft-deletes the local account: hosted draft/scheduled parties are cancelled, live ones ended, joined parties left, friendships closed, push token removed. Wallet/ledger history is kept. 502 (nothing changed, safe to retry) if Clerk fails. The bearer token stops working afterwards. Rate-limited: 3/min (`account-deletion`)."
          }
        }
      ]
    },
    {
      "name": "Game Types",
      "item": [
        {
          "name": "List game types",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length) { pm.collectionVariables.set('game_type_id', body.data[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/game-types?per_page=20",
              "host": ["{{base_url}}"],
              "path": ["game-types"],
              "query": [{ "key": "per_page", "value": "20" }, { "key": "search", "value": "", "disabled": true }, { "key": "cursor", "value": "", "disabled": true }]
            }
          }
        }
      ]
    },
    {
      "name": "Packs",
      "item": [
        {
          "name": "List packs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length) { pm.collectionVariables.set('pack_id', body.data[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/packs?per_page=20",
              "host": ["{{base_url}}"],
              "path": ["packs"],
              "query": [
                { "key": "per_page", "value": "20" },
                { "key": "category", "value": "family", "disabled": true },
                { "key": "game_type_id", "value": "{{game_type_id}}", "disabled": true },
                { "key": "search", "value": "", "disabled": true },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Featured packs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/packs/featured", "host": ["{{base_url}}"], "path": ["packs", "featured"] }
          }
        },
        {
          "name": "Show pack",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/packs/{{pack_id}}", "host": ["{{base_url}}"], "path": ["packs", "{{pack_id}}"] },
            "description": "Full (non-preview) cards are included only if you own the pack; otherwise preview cards only."
          }
        },
        {
          "name": "Purchase pack",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{base_url}}/packs/{{pack_id}}/purchase", "host": ["{{base_url}}"], "path": ["packs", "{{pack_id}}", "purchase"] },
            "description": "Debits your wallet. Idempotency-Key header is required (PurchasePackRequest). Rate-limited: 10/min (`purchases`)."
          }
        }
      ]
    },
    {
      "name": "Token Bundles",
      "item": [
