              "path": ["badges"],
              "query": [{ "key": "per_page", "value": "20" }, { "key": "cursor", "value": "", "disabled": true }]
            }
          }
        },
        {
          "name": "My badges",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/me/badges?per_page=20",
              "host": ["{{base_url}}"],
